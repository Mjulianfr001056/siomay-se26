# Public HTTPS base URL of the deployed Cloudflare Worker (no trailing slash).
# Copy this file to .env and replace the example hostname.
SIOMAY_DRIVE_FOLDER_WORKER_URL=https://siomay-drive-folder-listing.example.workers.dev

# GOOGLE_DRIVE_API_KEY does not belong here. Store it with:
# cd worker; npx wrangler secret put GOOGLE_DRIVE_API_KEY